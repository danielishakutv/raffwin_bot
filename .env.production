# Production build (npm run build / "main" branch deployment).
# VITE_ALLOW_BROWSER must stay unset or false. The app additionally refuses
# the bypass whenever VITE_APP_ENV=production, so it cannot be enabled by mistake.
VITE_APP_ENV=production
VITE_BOT_USERNAME=raffwin_bot
VITE_APP_VERSION=
VITE_BASE_PATH=/raffwin_bot/
