# ---------------------------------------------------------------------------
# Raffle Win bot - environment
# Copy to bot/.env for local runs. NEVER commit a real token.
# ---------------------------------------------------------------------------

# From @BotFather (/newbot or /token). Keep this secret.
BOT_TOKEN=123456789:replace-with-your-bot-token

# The Mini App URL the inline buttons open. Point it at production for
# @raffwin_bot and at the staging URL for the test bot.
#   production: https://danielishakutv.github.io/raffwin_bot/
#   staging:    https://danielishakutv.github.io/raffwin_bot/staging/
BOT_WEBAPP_URL=https://danielishakutv.github.io/raffwin_bot/

# Optional label shown in /help so testers know which environment they hit.
BOT_ENV=production

# Webhook mode only (Render / Railway / any Node host):
# Public HTTPS URL of the deployed bot, used by `npm run set-webhook`.
WEBHOOK_URL=https://your-bot-host.example.com/api/webhook
# Optional shared secret, sent by Telegram as X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=
# Port for the webhook HTTP server (hosts usually inject this).
PORT=3000
