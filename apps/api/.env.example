# ---------------------------------------------------------------------------
# Raffle Win API - environment
# Copy to apps/api/.env for local runs. .env is gitignored: never commit it.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3100
HOST=127.0.0.1

# Local database (role and databases created once with psql, see README)
DATABASE_URL=postgres://raffwin:CHANGE_ME@localhost:5432/raffwin_dev
# Tests: each run creates a fresh schema t_<time>_<random> in this database and
# never drops anything. Clear old ones whenever you like.
TEST_DATABASE_URL=postgres://raffwin:CHANGE_ME@localhost:5432/raffwin_test

# The bot that hosts the Mini App (@raffwin_test_bot for local and staging).
# initData is signed with this token, so it must match the bot that opened the app.
BOT_TOKEN=123456789:replace-with-the-test-bot-token-from-botfather
BOT_USERNAME=raffwin_test_bot

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IP_HASH_SALT=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INITDATA_MAX_AGE_SECONDS=3600
INITDATA_SINGLE_USE=false

# Encrypts admin authenticator secrets at rest: 32 random bytes, base64url (43 chars)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_DATA_KEY=
ADMIN_SESSION_HOURS=8
ADMIN_IDLE_MINUTES=30
ADMIN_SUPER_IDLE_MINUTES=120
# Cloudflare Access in front of the admin site (required in staging and production)
# CF_ACCESS_TEAM_DOMAIN=rafflewin.cloudflareaccess.com
# CF_ACCESS_AUD=<application audience tag from Zero Trust > Access > Applications>

# Browser origins allowed to call the API (the Mini App's own URL)
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=loopback
LOG_LEVEL=info

# Background workers: the bot's outbox sender (every 1.5 s) and the scheduler
# (every minute: broadcast fan-out, inactivity reminders, come-back offers).
# on (default) in every API process: an advisory lock in Postgres lets only one
# process work at a time, so PM2 cluster mode never sends a message twice.
# off: HTTP only, nothing is sent from this process.
WORKERS=on
