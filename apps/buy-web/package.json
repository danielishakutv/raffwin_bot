{
  "name": "@instaplay/buy-web",
  "private": true,
  "version": "0.1.0",
  "description": "The Raffs sales site: Telegram login and Paystack checkout. Talks only to its own backend under /api.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node ../../scripts/check-separation.mjs",
    "build:staging": "tsc --noEmit && vite build --mode staging && node ../../scripts/check-separation.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
