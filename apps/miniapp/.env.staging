# Staging build (npm run build:staging / "staging" branch deployment).
# Shows the STAGING badge in the UI. Browser bypass stays off: test it from
# the test bot (for example @raffwin_test_bot) pointed at the staging URL.
VITE_APP_ENV=staging
VITE_BOT_USERNAME=raffwin_test_bot
VITE_ALLOW_BROWSER=false
VITE_APP_VERSION=
VITE_BASE_PATH=/raffwin_bot/staging/
