# Test build (pnpm --filter @raffwin/miniapp build:staging), served from the test host.
# Opened from @raffwin_test_bot only. Shows the STAGING badge; browser bypass stays off.
# The API is served on the same host under /api (Apache proxies it), so no CORS and no second domain.
VITE_APP_ENV=staging
VITE_BOT_USERNAME=raffwin_test_bot
VITE_ALLOW_BROWSER=false
VITE_APP_VERSION=
VITE_BASE_PATH=/
VITE_API_URL=/api
