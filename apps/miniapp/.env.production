# Live build for https://raffwin.toko.com.ng/ (pnpm --filter @raffwin/miniapp build).
# Opened from @raffwin_bot only. VITE_ALLOW_BROWSER must stay unset or false; the app
# also refuses the bypass whenever VITE_APP_ENV=production.
# The API is served on the same host under /api (Apache proxies it).
VITE_APP_ENV=production
VITE_BOT_USERNAME=raffwin_bot
VITE_APP_VERSION=
VITE_BASE_PATH=/
VITE_API_URL=/api
