# Sales site backend. Copy to .env for local work; on the server the same
# names live in a root-only EnvironmentFile. Every value is secret unless noted.
# Never put the main API's address anywhere but MAIN_API_URL here.

NODE_ENV=development              # development | test | staging | production
PORT=3420                         # not secret
HOST=127.0.0.1                    # not secret; Apache forwards /api here
DATABASE_URL=postgres://instaplay:CHANGE_ME@127.0.0.1:5435/instaplay
PUBLIC_URL=https://buy.example.ng # not secret: this site's own address
IP_HASH_SALT=                     # openssl rand -hex 16
TRUST_PROXY=loopback
# Behind Cloudflare, the visitor's address arrives in this header:
#CLIENT_IP_HEADER=cf-connecting-ip
WORKERS=on

# Telegram Login Widget: a login bot of its own, its domain set in BotFather (/setdomain)
LOGIN_BOT_TOKEN=
LOGIN_BOT_USERNAME=
#LOGIN_MAX_AGE_SECONDS=86400
#SESSION_DAYS=30

# Paystack: sk_test_ on staging, sk_live_ on production (the API refuses to start otherwise)
PAYSTACK_SECRET_KEY=
#PAYSTACK_API_URL=https://api.paystack.co
# Optional: only these addresses may post the webhook (comma-separated, from Paystack's docs)
#PAYSTACK_WEBHOOK_IPS=

# The main API, through the signed relay. RELAY_SECRET and RELAY_PATH are the
# same values as the main API's own RELAY_SECRET and RELAY_PATH.
MAIN_API_URL=
RELAY_SECRET=
RELAY_PATH=

# Rules of sale
#QUOTE_MINUTES=30
#CREDIT_WINDOW_MINUTES=120
#RECONCILE_HOUR=2

# Tests only: a local database the test run may create schemas in
TEST_DATABASE_URL=
