# ---------------------------------------------------------------------------
# Raffle Win - Mini App environment variables
# Copy to .env.development / .env.staging / .env.production as needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put secrets here: everything in this file ends up in the client build.
# ---------------------------------------------------------------------------

# Which environment this build is for: development | staging | production
VITE_APP_ENV=development

# Username of the Telegram bot that hosts the Mini App (no @)
VITE_BOT_USERNAME=raffwin_bot

# Dev bypass for the "open in Telegram" gate.
# true  -> the app also runs in a normal browser (local development only)
# false / unset -> the app refuses to run outside Telegram
# The app ignores this flag entirely when VITE_APP_ENV=production.
VITE_ALLOW_BROWSER=false

# Optional version label. Leave empty to use the version from package.json
# (plus the short git SHA when available) - set automatically at build time.
VITE_APP_VERSION=

# Base URL path the app is served from. "/" for a root domain, "/raffwin_bot/"
# for the GitHub Pages project site, "/raffwin_bot/staging/" for staging.
VITE_BASE_PATH=/
