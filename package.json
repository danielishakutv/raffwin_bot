{
  "name": "raffwin",
  "private": true,
  "description": "Raffle Win - Telegram Mini App, API and admin (pnpm workspace)",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @raffwin/miniapp dev",
    "dev:api": "pnpm --filter @raffwin/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @raffwin/api db:generate",
    "db:migrate": "pnpm --filter @raffwin/api db:migrate",
    "check:separation": "node scripts/check-separation.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
